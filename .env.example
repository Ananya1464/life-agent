# Copy this to .env and fill in your secrets
# The run_daily.bat script will load these

# LLM brain — Primary provider (Gemini free tier, $0/month)
GEMINI_API_KEY=AIzaSyxxxxx
GEMINI_MODEL=gemini-3.5-flash

# Force provider: "gemini" (default) or "nvidia"
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
LLM_MAX_RETRIES=3

# Fallback provider: "nvidia" (default) - used when primary fails
LLM_FALLBACK_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Notion (required)
NOTION_TOKEN=ntn_xxxxx

# Notion page IDs (optional if using defaults, which are pre-filled in config.py)
DAILY_LOG_DATA_SOURCE_ID=c4764f6a-59f1-466d-843f-eb798eb3b033
WEIGHT_LOSS_PAGE_ID=37ade9d3d9b781a9bfcbecdf326bf6b9

# Notion Reminders database (fill after creating — see GITHUB_SETUP.md)
REMINDERS_DB_ID=

# ADHD Focus Upgrades (optional databases)
DOPAMINE_MENU_DB_ID=
BRAIN_DUMP_DB_ID=

# Push Notifications (ntfy.sh - required for deep_work_session)
# Pick a completely unique random string, e.g. "your_unique_topic_here"
NTFY_TOPIC=

# Email (optional — if empty, email delivery is skipped)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Calendar (optional — secret iCal URL)
ICAL_URL=https://calendar.google.com/calendar/ical/xxxx/private/basic.ics

# Timezone
TIMEZONE=Asia/Kolkata
