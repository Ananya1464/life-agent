# Copy this to .env and fill in your secrets
# The run_daily.bat script will load these

# LLM brain — Gemini free tier (default, $0/month)
GEMINI_API_KEY=AIzaSyxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Force Gemini only (prevents accidental Claude token spend)
# Change to "claude" and set ANTHROPIC_API_KEY to switch back
LLM_PROVIDER=gemini

# Optional: Real Claude (pay-per-use, ~$3-5/month)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Notion (required)
NOTION_TOKEN=ntn_xxxxx

# Notion page IDs (optional if using defaults, which are pre-filled in config.py)
DAILY_LOG_DATA_SOURCE_ID=c4764f6a-59f1-466d-843f-eb798eb3b033
WEIGHT_LOSS_PAGE_ID=37ade9d3d9b781a9bfcbecdf326bf6b9

# Notion Reminders database (optional — needed for phone push notifications)
# Create a database in Notion with Name (title) + When (date) properties,
# then paste its ID here. See GITHUB_SETUP.md for detailed steps.
REMINDERS_DB_ID=

# Email (optional — if empty, email delivery is skipped)
GMAIL_ADDRESS=ananyadubey1464@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Calendar (optional — secret iCal URL)
ICAL_URL=https://calendar.google.com/calendar/ical/xxxxx/private/basic.ics

# Timezone
TIMEZONE=Asia/Kolkata
